---
import raw from '../design/PortfolioHero.html?raw';

const head = raw.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = (raw.match(/<body>([\s\S]*?)<\/body>/i)?.[1] ?? '')
  .replace(/<template id="__bundler_thumbnail"[\s\S]*?<\/template>/i, '');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Shahnaz Khan — Product Designer</title>
    <meta name="description" content="Portfolio of Shahnaz Khan, product designer: the Luv or Pop case study and an AI memory prototype." />
    <Fragment set:html={head} />
  </head>
  <body>
    <Fragment set:html={body} />
  </body>
</html>
